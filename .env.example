# --- Database ---
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change_me
POSTGRES_DB=attendance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host-side ports for docker compose. Postgres deliberately avoids 5432, which is
# usually already taken on a developer machine.
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
DATABASE_URL=postgresql+psycopg://attendance:change_me@localhost:5432/attendance

# --- ML service endpoints ---
LIVENESS_SERVICE_URL=http://localhost:8001
RECOGNITION_SERVICE_URL=http://localhost:8002

# --- Decision thresholds ---
# LIVENESS_THRESHOLD is calibrated on VALIDATION data (min-ACER criterion) from
# training run 2 (modelA_cnn). Test ACER 9.74%, APCER 10.39%, BPCER 9.09%.
# Retraining changes this value; keep it with the run that produced it.
LIVENESS_THRESHOLD=0.4535
FACE_MATCH_THRESHOLD=0.50

# --- Model versions (stored alongside every embedding) ---
LIVENESS_MODEL_VERSION=modelA_cnn
RECOGNITION_MODEL_VERSION=buffalo_l

# --- API ---
API_KEY=change_me
LOG_LEVEL=INFO
